data/
*.RData
*.parquet
*.dat

# Resultados pesados. Los resumenes SI se versionan (ver results/summary/).
results/raw/
results/figures/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.pytest_cache/

# La memoria vive en la carpeta compartida, no aqui.
*.docx
*.doc

# Comprimidos: copias y paquetes de cambios que no son codigo. GitHub rechaza
# ficheros de mas de 100 MB. (Que un LICENSE.zip no entre en la rueda lo
# garantiza license-files = ["LICENSE"] en pyproject.toml, no esta linea.)
*.zip

# Sistema
.DS_Store
Thumbs.db
